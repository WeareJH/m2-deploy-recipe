{
    "name": "wearejh/m2-deploy-recipe",
    "description": "Deployer Recipe for Magento 2 (JH extensions for deployer 8.x)",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "cweagans/composer-patches": "^2.0",
        "deployer/deployer": "^8.0"
    },
    "minimum-stability": "RC",
    "prefer-stable": true,
    "autoload": {
        "files": [
            "autoload.php"
        ]
    },
    "extra": {
        "patches": {
            "deployer/deployer": {
                "Fix Malformed request line race condition (non-blocking socket read)": "patches/deployer-fix-malformed-request.patch"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "cweagans/composer-configurable-plugin": true
        }
    }
}
